{
  "name": "cookclub-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "check-types": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --no-error-on-unmatched-pattern",
    "deploy": "vite build && wrangler deploy",
    "deploy:prod": "CLOUDFLARE_ENV=production vite build && wrangler deploy --env production"
  },
  "dependencies": {
    "@repo/trpc": "workspace:*",
    "@tanstack/react-query": "5.100.14",
    "@tanstack/react-router": "1.170.10",
    "@tanstack/react-start": "1.168.18",
    "better-auth": "1.6.11",
    "lucide-react": "1.17.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.39.0",
    "@cloudflare/workers-types": "4.20260525.1",
    "@repo/tsconfig": "workspace:*",
    "@tanstack/router-plugin": "1.168.18",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint-config-universe": "15.2.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "wrangler": "4.94.0"
  },
  "eslintConfig": {
    "extends": "universe/web"
  },
  "nx": {
    "tags": [
      "type:app",
      "runtime:worker",
      "runtime:web"
    ]
  }
}
