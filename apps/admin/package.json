    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.39.0",
    "@cloudflare/workers-types": "5.20260801.1",
    "@repo/tsconfig": "workspace:*",
    "@tanstack/router-plugin": "1.168.23",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
