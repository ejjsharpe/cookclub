{
  "name": "cookclub-api",
  "exports": {
    "./service-types": "./src/service-types.ts"
  },
  "scripts": {
    "dev": "wait-on tcp:8788 && wait-on tcp:8789 && bun scripts/dev.mjs",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy --minify",
    "deploy:prod": "wrangler deploy --env production --minify",
    "generate:worker-types": "wrangler types --env production --env-file .dev.vars.example --strict-vars=false --include-runtime=false",
    "check:worker-types": "wrangler types --env production --env-file .dev.vars.example --strict-vars=false --include-runtime=false --check",
    "check-types": "bun run check:worker-types && tsc --noEmit",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/trpc-server": "0.4.2",
    "@repo/auth": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/trpc": "workspace:*",
    "@sentry/cloudflare": "10.66.0",
    "@sentry/hono": "10.66.0",
    "hono": "4.12.23"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260719.1",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "25.9.1",
    "eslint-config-universe": "15.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.7",
    "wait-on": "9.0.10",
    "wrangler": "4.112.0"
  },
  "eslintConfig": {
    "extends": "universe/node"
  },
  "nx": {
    "tags": [
      "type:app",
      "runtime:worker"
    ]
  }
}
