{
  "name": "cookclub-api",
  "exports": {
    "./service-types": "./src/service-types.ts"
  },
  "scripts": {
    "dev": "wait-on tcp:8788 && wait-on tcp:8789 && bun scripts/dev.mjs",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy --minify",
    "deploy:prod": "wrangler deploy --env production --minify",
    "check-types": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/trpc-server": "0.4.2",
    "@repo/auth": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/trpc": "workspace:*",
    "hono": "4.12.23"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.9",
    "@cloudflare/workers-types": "4.20260525.1",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "26.0.0",
    "eslint-config-universe": "15.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "wait-on": "9.0.10",
    "wrangler": "4.94.0"
  },
  "eslintConfig": {
    "extends": "universe/node"
  },
  "nx": {
    "tags": [
      "type:app",
      "runtime:worker"
    ]
  }
}
