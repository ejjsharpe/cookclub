{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cookclub-api-development",
  "main": "src/index.ts",
  "account_id": "46fa47bc2bba51d75383b4dfe6e3deb1",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2025-02-20",
  "dev": {
    "port": 8787,
  },
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "queues": {
    "producers": [
      {
        "binding": "RECIPE_IMPORT_BASIC_QUEUE",
        "queue": "cookclub-recipe-import-basic-development",
      },
      {
        "binding": "RECIPE_IMPORT_URL_QUEUE",
        "queue": "cookclub-recipe-import-url-development",
      },
      {
        "binding": "RECIPE_IMPORT_TEXT_QUEUE",
        "queue": "cookclub-recipe-import-text-development",
      },
      {
        "binding": "RECIPE_IMPORT_IMAGE_QUEUE",
        "queue": "cookclub-recipe-import-image-development",
      },
    ],
    "consumers": [
      {
        "queue": "cookclub-recipe-import-basic-development",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 50,
      },
      {
        "queue": "cookclub-recipe-import-url-development",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 30,
      },
      {
        "queue": "cookclub-recipe-import-text-development",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 20,
      },
      {
        "queue": "cookclub-recipe-import-image-development",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 8,
      },
    ],
  },
  "services": [
    {
      "binding": "RECIPE_AI",
      "service": "cookclub-recipe-ai-development",
      "entrypoint": "RecipeAI",
    },
    {
      "binding": "IMAGE_SERVICE",
      "service": "cookclub-images-development",
      "entrypoint": "ImageService",
    },
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "4602001",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "4602002",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "IMAGE_AI_RATE_LIMITER",
      "namespace_id": "4602003",
      "simple": { "limit": 6, "period": 60 },
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "4602004",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
    // Public URL for images (dev uses R2 public URL, prod uses custom domain)
    "IMAGE_PUBLIC_URL": "https://pub-8a33f3240252485aa859a3ac8dd49465.r2.dev",
    "APPLE_BUNDLE_IDENTIFIER": "com.shakyhand.cookclub",
    "ADAPTY_PRO_ACCESS_LEVEL_ID": "pro",
  },
  "durable_objects": {
    "bindings": [{ "name": "USER_FEED", "class_name": "FeedDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FeedDO"] }],
  // Production environment overrides
  "env": {
    "production": {
      "name": "cookclub-api-production",
      "services": [
        {
          "binding": "RECIPE_AI",
          "service": "cookclub-recipe-ai-production",
          "entrypoint": "RecipeAI",
        },
        {
          "binding": "IMAGE_SERVICE",
          "service": "cookclub-images-production",
          "entrypoint": "ImageService",
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "USER_FEED", "class_name": "FeedDO" }],
      },
      "queues": {
        "producers": [
          {
            "binding": "RECIPE_IMPORT_BASIC_QUEUE",
            "queue": "cookclub-recipe-import-basic-production",
          },
          {
            "binding": "RECIPE_IMPORT_URL_QUEUE",
            "queue": "cookclub-recipe-import-url-production",
          },
          {
            "binding": "RECIPE_IMPORT_TEXT_QUEUE",
            "queue": "cookclub-recipe-import-text-production",
          },
          {
            "binding": "RECIPE_IMPORT_IMAGE_QUEUE",
            "queue": "cookclub-recipe-import-image-production",
          },
        ],
        "consumers": [
          {
            "queue": "cookclub-recipe-import-basic-production",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "max_concurrency": 50,
          },
          {
            "queue": "cookclub-recipe-import-url-production",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "max_concurrency": 30,
          },
          {
            "queue": "cookclub-recipe-import-text-production",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "max_concurrency": 20,
          },
          {
            "queue": "cookclub-recipe-import-image-production",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "max_concurrency": 8,
          },
        ],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FeedDO"] }],
      "routes": [{ "pattern": "api.cookclub.app", "custom_domain": true }],
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "4601001",
          "simple": { "limit": 300, "period": 60 },
        },
        {
          "name": "AI_RATE_LIMITER",
          "namespace_id": "4601002",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "IMAGE_AI_RATE_LIMITER",
          "namespace_id": "4601003",
          "simple": { "limit": 6, "period": 60 },
        },
        {
          "name": "UPLOAD_RATE_LIMITER",
          "namespace_id": "4601004",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
      "vars": {
        "BETTER_AUTH_URL": "https://api.cookclub.app",
        "IMAGE_PUBLIC_URL": "https://images.cookclub.app",
        "APPLE_BUNDLE_IDENTIFIER": "com.shakyhand.cookclub",
        "ADAPTY_PRO_ACCESS_LEVEL_ID": "pro",
      },
    },
  },
}
