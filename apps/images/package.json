{
  "name": "cookclub-images",
  "type": "module",
  "exports": {
    "./service": "./src/service.ts"
  },
  "scripts": {
    "dev": "wrangler dev --inspector-port 9231",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy --minify",
    "deploy:prod": "wrangler deploy --env production --minify",
    "check-types": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "aws4fetch": "1.0.20",
    "hono": "4.12.23",
    "jpeg-js": "0.4.4",
    "thumbhash": "0.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260525.1",
    "@repo/tsconfig": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "4.1.7",
    "wrangler": "4.112.0"
  },
  "eslintConfig": {
    "extends": "universe/node"
  },
  "nx": {
    "tags": [
      "type:app",
      "runtime:worker"
    ]
  }
}
