EXPO_PUBLIC_AUTH_BASE_URL=https://api.cookclub.app
EXPO_PUBLIC_API_URL=https://api.cookclub.app/trpc
# Optional override for the shared browser page used by password recovery.
# Defaults to cookclub.app with HTTPS APIs, or the API host on port 4321 locally.
EXPO_PUBLIC_PASSWORD_RESET_URL=
EXPO_PUBLIC_ADAPTY_PUBLIC_SDK_KEY=
EXPO_PUBLIC_ADAPTY_PAYWALL_PLACEMENT_ID=pro_paywall
EXPO_PUBLIC_ADAPTY_PRO_ACCESS_LEVEL_ID=pro
EXPO_PUBLIC_SENTRY_DSN=

# Sentry build-time auth for source maps and debug symbols.
# Set this in EAS/local build environments, not in app code.
SENTRY_AUTH_TOKEN=
