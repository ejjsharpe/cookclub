{
  "expo": {
    "name": "cookclub",
    "slug": "cookclub",
    "owner": "shakyhand",
    "version": "1.0.0",
    "scheme": "cookclub",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "tsconfigPaths": true,
      "reactCompiler": true
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "cook-club-native",
          "organization": "shaky-hand"
        }
      ],
      ["expo-font"],
      "expo-web-browser",
      "react-native-edge-to-edge",
      [
        "./plugins/withShareExtensionReleaseSettings",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "androidIntentFilters": ["text/*", "image/*"],
          "androidMultiIntentFilters": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic",
            "buildReactNativeFromSource": true
          }
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow cookclub to access your photos so you can add images to your recipes and profile.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF0027",
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "deploymentTarget": "16.4",
      "bundleIdentifier": "com.shakyhand.cookclub",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow cookclub to access your photos so you can choose a profile picture."
      },
      "icon": "./assets/cookclub.icon",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FF0027"
      },
      "package": "com.shakyhand.cookclub",
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "eas": {
        "projectId": "b8626cb5-f771-4f18-bd9f-07b048414cf4"
      }
    }
  }
}
