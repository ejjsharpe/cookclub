{
  "expo": {
    "name": "cookclub",
    "slug": "cookclub",
    "owner": "shakyhand",
    "version": "1.0.0",
    "scheme": "cookclub",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "tsconfigPaths": true,
      "reactCompiler": true
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
          [
      "@sentry/react-native/expo",
      {
        "url": "https://sentry.io/",
        "project": "cook-club",
        "organization": "shaky-hand"
      }
    ],
      [
        "expo-font"
      ],
      "expo-web-browser",
      "react-native-edge-to-edge",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ],
          "androidMultiIntentFilters": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow cookclub to access your photos so you upload add images to your recipes and profile."
        }
      ],
      "expo-notifications"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shakyhand.cookclub",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow cookclub to access your photos so you can choose a profile picture."
      },
      "icon": "./assets/cookclub.icon",
      "splash": {
        "image": "./assets/ios-splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#FF0027"
    }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FF0027"
      },
      "splash": {
        "image": "./assets/android-splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#FF0027"
    },
      "package": "com.shakyhand.cookclub",
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "eas": {
        "projectId": "b8626cb5-f771-4f18-bd9f-07b048414cf4"
      }
    }
  }
}
