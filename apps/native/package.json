{
  "name": "cook-club-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "expo run:ios",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "build:preview:local": "eas build --platform ios --profile preview --local --output ./cookclub-preview.ipa",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "web": "expo start --web"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.14",
    "@expo/vector-icons": "15.1.1",
    "@lodev09/react-native-true-sheet": "3.10.1",
    "@react-navigation/bottom-tabs": "7.16.1",
    "@react-navigation/native": "7.2.4",
    "@react-navigation/native-stack": "7.15.1",
    "@repo/contracts": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/trpc": "workspace:*",
    "@sentry/react-native": "8.12.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-async-storage-persister": "5.100.14",
    "@tanstack/react-query": "5.100.14",
    "@tanstack/react-query-persist-client": "5.100.14",
    "better-auth": "1.6.11",
    "date-fns": "4.3.0",
    "expo": "55.0.26",
    "expo-apple-authentication": "55.0.13",
    "expo-blur": "55.0.14",
    "expo-build-properties": "55.0.14",
    "expo-constants": "55.0.16",
    "expo-dev-client": "55.0.35",
    "expo-font": "55.0.8",
    "expo-image": "55.0.11",
    "expo-image-manipulator": "55.0.17",
    "expo-image-picker": "55.0.20",
    "expo-keep-awake": "55.0.8",
    "expo-linear-gradient": "55.0.14",
    "expo-linking": "55.0.15",
    "expo-network": "55.0.14",
    "expo-notifications": "55.0.23",
    "expo-share-intent": "6.1.1",
    "expo-splash-screen": "55.0.21",
    "expo-status-bar": "55.0.6",
    "expo-system-ui": "55.0.18",
    "expo-web-browser": "55.0.16",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-actions-sheet": "10.1.2",
    "react-native-adapty": "3.15.6",
    "react-native-edge-to-edge": "1.6.0",
    "react-native-gesture-handler": "2.30.1",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-mmkv": "3.3.3",
    "react-native-nitro-modules": "0.35.7",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.3",
    "react-native-unistyles": "3.2.4",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@types/react": "19.2.15",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "eslint": "8.57.1",
    "eslint-config-universe": "15.2.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "eslintConfig": {
    "extends": "universe/native"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-screens"
      ]
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "DISABLE_COMMIT_PAUSING_MECHANISM": true,
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "private": true,
  "trustedDependencies": [
    "react-native-nitro-modules"
  ],
  "nx": {
    "tags": [
      "type:app",
      "runtime:native"
    ]
  }
}
