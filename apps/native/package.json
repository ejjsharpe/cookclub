{
  "name": "cook-club-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "expo run:ios",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "build:preview:local": "eas build --platform ios --profile preview --local --output ./cookclub-preview.ipa",
    "prebuild": "expo prebuild",
    "check-types": "tsc --noEmit",
    "check:expo": "expo install --check && expo-doctor",
    "check:expo-install": "expo install --check",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" --max-warnings=0",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "web": "expo start --web"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.26",
    "@expo/vector-icons": "15.1.1",
    "@lodev09/react-native-true-sheet": "3.10.1",
    "@react-navigation/bottom-tabs": "7.16.1",
    "@react-navigation/native": "7.2.4",
    "@react-navigation/native-stack": "7.15.1",
    "@repo/contracts": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/trpc": "workspace:*",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-async-storage-persister": "5.101.4",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-persist-client": "5.101.4",
    "better-auth": "1.6.25",
    "date-fns": "4.3.0",
    "expo": "~57.0.12",
    "expo-apple-authentication": "~57.0.1",
    "expo-build-properties": "~57.0.10",
    "expo-constants": "57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.11",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-manipulator": "~57.0.9",
    "expo-image-picker": "~57.0.9",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "57.0.5",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.10",
    "expo-share-intent": "8.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.13",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-adapty": "4.0.2",
    "react-native-edge-to-edge": "1.6.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.35.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-unistyles": "3.2.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@repo/tsconfig": "workspace:*",
    "@types/react": "19.2.17",
    "expo-doctor": "1.20.1",
    "typescript": "~6.0.3",
    "vitest": "4.1.7"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "DISABLE_COMMIT_PAUSING_MECHANISM": true,
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "private": true,
  "trustedDependencies": [
    "react-native-nitro-modules"
  ],
  "nx": {
    "tags": [
      "type:app",
      "runtime:native"
    ]
  }
}
