{
  "name": "cookclub-native",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "expo run:ios",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "build:preview:local": "eas build --platform ios --profile preview --local --output ./cookclub-preview.ipa",
    "prebuild": "expo prebuild",
    "check-types": "tsc --noEmit",
    "check:expo": "expo install --check && expo-doctor",
    "check:expo-install": "expo install --check",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" --max-warnings=0",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "web": "expo start --web"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.26",
    "@expo/vector-icons": "15.1.1",
    "@lodev09/react-native-true-sheet": "3.10.1",
    "@react-navigation/bottom-tabs": "7.22.0",
    "@react-navigation/native": "7.5.2",
    "@react-navigation/native-stack": "7.21.1",
    "@repo/contracts": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/trpc": "workspace:*",
    "@sentry/react-native": "~8.28.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/query-async-storage-persister": "5.108.1",
    "@tanstack/react-query": "5.108.1",
    "@tanstack/react-query-persist-client": "5.108.1",
    "better-auth": "1.7.26",
    "date-fns": "4.4.0",
    "expo": "^58.0.0",
    "expo-apple-authentication": "~58.0.3",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.4",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-share-intent": "^9.0.0",
    "expo-splash-screen": "~58.0.14",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-adapty": "4.3.10",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-unistyles": "3.8.2",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@repo/tsconfig": "workspace:*",
    "@types/react": "~19.3.0",
    "expo-doctor": "1.21.8",
    "typescript": "~6.0.3",
    "vitest": "4.1.7"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "DISABLE_COMMIT_PAUSING_MECHANISM": true,
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "private": true,
  "trustedDependencies": [
    "react-native-nitro-modules"
  ],
  "nx": {
    "tags": [
      "type:app",
      "runtime:native"
    ]
  }
}
