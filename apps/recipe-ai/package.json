{
  "name": "cookclub-recipe-ai",
  "type": "module",
  "exports": {
    "./service": "./src/service.ts"
  },
  "scripts": {
    "dev": "wrangler dev --inspector-port 9230",
    "generate:worker-types": "wrangler types --env production --env-file .dev.vars.example --strict-vars=false --include-runtime=false",
    "check:worker-types": "wrangler types --env production --env-file .dev.vars.example --strict-vars=false --include-runtime=false --check",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy --minify",
    "deploy:prod": "wrangler deploy --env production --minify",
    "check-types": "bun run check:worker-types && tsc --noEmit",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" --max-warnings=0",
    "dry-run:prod": "wrangler deploy --env production --minify --dry-run",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.3.0",
    "@repo/contracts": "workspace:*",
    "@repo/shared": "workspace:*",
    "arktype": "2.2.3",
    "cheerio": "1.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@cloudflare/workers-types": "5.20260801.1",
    "@repo/tsconfig": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "4.1.7",
    "wrangler": "4.118.0"
  },
  "nx": {
    "tags": [
      "type:app",
      "runtime:worker"
    ]
  }
}
