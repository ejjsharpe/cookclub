{
  "name": "cookclub-recipe-ai",
  "type": "module",
  "exports": {
    "./service": "./src/service.ts"
  },
  "scripts": {
    "dev": "wrangler dev --inspector-port 9230",
    "generate-types": "wrangler types --env-file .dev.vars.example",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy --minify",
    "deploy:prod": "wrangler deploy --env production --minify",
    "check-types": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.1.0",
    "@repo/contracts": "workspace:*",
    "@repo/shared": "workspace:*",
    "arktype": "2.2.0",
    "cheerio": "1.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.9",
    "@repo/tsconfig": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "4.1.7",
    "wrangler": "4.94.0"
  },
  "eslintConfig": {
    "extends": "universe/node"
  },
  "nx": {
    "tags": [
      "type:app",
      "runtime:worker"
    ]
  }
}
