{
  "name": "cookclub-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "check-types": "astro check",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --no-error-on-unmatched-pattern",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "5.0.5",
    "@astrojs/sitemap": "3.7.2",
    "astro": "6.3.7",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint-config-universe": "15.2.0",
    "typescript": "6.0.3",
    "wrangler": "4.110.0"
  },
  "eslintConfig": {
    "extends": "universe/web"
  },
  "nx": {
    "tags": [
      "type:app",
      "runtime:web"
    ]
  }
}
