{
  "name": "cookclub-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "check-types": "astro check",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --no-error-on-unmatched-pattern --max-warnings=0",
    "deploy": "astro build && wrangler deploy",
    "deploy:prod": "astro build && wrangler deploy",
    "dry-run:prod": "astro build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/react": "6.0.2",
    "@astrojs/sitemap": "3.7.6",
    "astro": "7.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "typescript": "6.0.3",
    "wrangler": "4.165.0"
  },
  "nx": {
    "tags": [
      "type:app",
      "runtime:web"
    ]
  }
}
