---
import Wordmark from "./Wordmark.astro";

const navItems = [
  { href: "/#features", label: "Features" },
  { href: "/privacy", label: "Privacy" },
  { href: "/terms", label: "Terms" },
  { href: "/support", label: "Support" },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="cookclub homepage">
      <img class="brand__mark" src="/icons/icon.png" alt="" width="36" height="36" />
      <Wordmark />
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      {
        navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
      <span class="nav-pill" aria-label="cookclub mobile apps coming soon">
        Apps coming soon
      </span>
    </nav>
    <details class="mobile-menu">
      <summary aria-label="Open navigation menu">
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <nav class="mobile-menu__nav" aria-label="Mobile navigation">
        {
          navItems.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
