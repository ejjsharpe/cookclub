---
import LegalPage from "../components/LegalPage.astro";
import Layout from "../components/Layout.astro";
import { deletionMailto, site, supportMailto } from "../data/site";
---

<Layout
  title="Delete Account"
  description="How to delete your cookclub account in the app or request deletion by email."
>
  <LegalPage
    title="Delete Account"
    intro="cookclub lets users delete their account in the app, and also provides an outside-app deletion request path for users who no longer have the app installed."
  >
    <p><strong>Last updated:</strong> {site.lastUpdated}</p>

    <div class="notice-box">
      <p>
        Need help deleting your account without the app?
        <a href={deletionMailto}>Email {site.supportEmail}</a> with the email
        address connected to your cookclub account and write that you want your
        cookclub account deleted.
      </p>
    </div>

    <h2>Delete Your Account In The App</h2>
    <ol>
      <li>Open cookclub.</li>
      <li>Go to <strong>Settings</strong>.</li>
      <li>Choose <strong>Delete Account</strong>.</li>
      <li>Follow the confirmation steps shown in the app.</li>
    </ol>

    <h2>Request Deletion Outside The App</h2>
    <p>
      If you uninstalled cookclub or cannot access the app, email
      <a href={deletionMailto}>{site.supportEmail}</a>. Include the email
      address used for your cookclub account. We may ask for additional
      verification before deleting account data.
    </p>
    <p>
      cookclub aims to complete verified deletion requests within 30 days unless
      additional time is required for legal, security, fraud prevention, dispute,
      backup, tax, accounting, or payment/subscription record reasons.
    </p>

    <h2>Subscriptions Are Separate</h2>
    <p>
      Deleting your cookclub account does not cancel subscriptions managed by
      Apple or Google. You must cancel those subscriptions through the platform
      where you subscribed:
    </p>
    <ul>
      <li><a href={site.appleSubscriptionsUrl}>Manage or cancel an Apple subscription</a>.</li>
      <li><a href={site.googleSubscriptionsUrl}>Manage or cancel a Google Play subscription</a>.</li>
    </ul>

    <h2>What Gets Deleted</h2>
    <p>
      Account deletion removes or de-identifies your cookclub account, profile,
      recipes, reviews, comments, follows, meal plans, shopping lists, and other
      user content associated with your account, subject to the retention limits
      below.
    </p>

    <h2>Information We May Retain</h2>
    <p>
      cookclub may retain limited information where required for legal,
      security, fraud prevention, abuse investigation, dispute, backup, tax,
      accounting, or payment/subscription record reasons. Retained information is
      limited to what is necessary for those purposes.
    </p>

    <h2>Questions</h2>
    <p>
      Contact <a href={supportMailto}>{site.supportEmail}</a> with account
      deletion questions.
    </p>
  </LegalPage>
</Layout>
