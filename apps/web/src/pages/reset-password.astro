---
import Layout from "../components/Layout.astro";
import PasswordReset from "../components/PasswordReset";

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL || (
  import.meta.env.DEV ? "http://localhost:8787" : "https://api.cookclub.app"
);
const adminSignInUrl = import.meta.env.PUBLIC_ADMIN_URL || (
  import.meta.env.DEV ? "http://localhost:3000" : "https://admin.cookclub.app"
);
---

<Layout title="Reset your password" description="Recover access to your Cook Club account." pageClass="password-reset-page" noIndex>
  <PasswordReset client:only="react" apiBaseUrl={apiBaseUrl} adminSignInUrl={adminSignInUrl}>
    <p slot="fallback" class="container" role="status">Loading password recovery…</p>
  </PasswordReset>
  <noscript><p class="container">Enable JavaScript to reset your password, or <a href="/support">contact support</a>.</p></noscript>
</Layout>
