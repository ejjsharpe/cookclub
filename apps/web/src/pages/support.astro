---
import LegalPage from "../components/LegalPage.astro";
import Layout from "../components/Layout.astro";
import { site, supportMailto } from "../data/site";
---

<Layout
  title="Support"
  description="Contact cookclub support for account, deletion, billing, safety, moderation, or app help."
>
  <LegalPage
    title="Support"
    intro="cookclub support is available for users, reviewers, and platform teams who need help with the app."
  >
    <p>
      Email cookclub support at <a href={supportMailto}>{site.supportEmail}</a>.
      cookclub is developed by {site.developer}.
    </p>

    <h2>Forgot Your Password?</h2>
    <p><a href="/reset-password">Request a password reset link</a> to recover access to your account.</p>

    <h2>What To Contact Us About</h2>
    <ul>
      <li>Account access, email verification, sign-in, or profile issues.</li>
      <li>Recipe import, AI recipe generation, images, meal plans, or shopping lists.</li>
      <li>Subscription status or billing questions.</li>
      <li>Account deletion or privacy requests.</li>
      <li>Safety, moderation, abusive content, infringing content, or user reports.</li>
      <li>App review or platform compliance questions.</li>
    </ul>

    <h2>Helpful Details</h2>
    <p>
      When you contact support, include the email address connected to your Cook
      Club account, the device platform you use, and a short description of the
      issue. Do not send passwords or payment card details.
    </p>

    <h2>Urgent Safety Reports</h2>
    <p>
      Use the in-app Report action when available so cookclub receives the
      relevant evidence snapshot. For urgent child-safety concerns, also email
      <a href="mailto:help@cookclub.app?subject=URGENT%3A%20Child%20safety%20report">help@cookclub.app</a>.
      If anyone is in immediate danger, contact local emergency services.
    </p>

    <h2>Account Deletion</h2>
    <p>
      For account deletion instructions, visit
      <a href="/delete-account">cookclub.app/delete-account</a>.
    </p>
  </LegalPage>
</Layout>
