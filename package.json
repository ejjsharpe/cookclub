{
  "name": "cook-club",
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "kill-ports": "for port in 8787 8788 8789 3000; do lsof -ti :$port | xargs kill -9 2>/dev/null; done; true",
    "dev": "nx run-many -t dev --parallel=10",
    "dev:api": "nx run-many -t dev --exclude=cook-club-app,cookclub-web --parallel=10",
    "build": "nx run-many -t build",
    "check-boundaries": "node tooling/check-boundaries.mjs",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "check-types": "nx run-many -t check-types",
    "check:expo": "bun run --cwd apps/native check:expo",
    "check:release": "bun run check-boundaries && bun run lint && bun run check-types && bun run test && bun run build && bun run check:expo",
    "deploy:api:prod": "bun run --cwd apps/api deploy:prod",
    "deploy:admin:prod": "bun run --cwd apps/admin deploy:prod",
    "deploy:recipe-ai:prod": "bun run --cwd apps/recipe-ai deploy:prod",
    "deploy:images:prod": "bun run --cwd apps/images deploy:prod",
    "deploy:web:prod": "bun run --cwd apps/web deploy:prod",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "overrides": {
    "expo-constants": "57.0.9",
    "expo-linking": "57.0.5"
  },
  "devDependencies": {
    "eas-cli": "21.6.0",
    "eslint": "10.8.0",
    "eslint-config-universe": "16.0.0",
    "nx": "23.1.1",
    "prettier": "3.9.6"
  },
  "trustedDependencies": [
    "@sentry/cli",
    "esbuild",
    "nx",
    "sharp",
    "workerd"
  ]
}
