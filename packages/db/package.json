{
  "name": "@repo/db",
  "version": "1.0.0",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./schemas": "./schemas/index.ts",
    "./services": "./services/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "generate": "dotenvx run -- drizzle-kit generate",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" --max-warnings=0",
    "migrate": "dotenvx run -- drizzle-kit migrate",
    "migrate:prod": "dotenvx run -f .env.production -- drizzle-kit migrate",
    "push": "dotenvx run -- drizzle-kit push",
    "push:prod": "dotenvx run -f .env.production -- drizzle-kit push",
    "reset:dev-schema": "dotenvx run -- bun run scripts/reset-dev-schema.ts",
    "seed": "dotenvx run -- bun run seed.ts",
    "seed:reset": "dotenvx run -- bun run seed.ts --clear",
    "seed:images": "dotenvx run -- bun run scripts/seed-images.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.1",
    "@repo/contracts": "workspace:*",
    "@repo/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261119.1",
    "@dotenvx/dotenvx": "1.68.1",
    "@repo/tsconfig": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "nx": {
    "tags": [
      "type:package",
      "scope:db"
    ]
  }
}
